// Uygulamayı Cloudflare'e yayınlar: flutter build web --release && npx wrangler deploy
{
  "name": "flutter-ankara-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "flutter-demo.poyrazavsever.com", "custom_domain": true }]
}
